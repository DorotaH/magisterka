{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["left", "right", "preference", "reason"],
  "properties": {
    "left": {"$ref": "#/$defs/rubric"},
    "right": {"$ref": "#/$defs/rubric"},
    "preference": {"enum": ["left", "right"]},
    "reason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "rating": {
      "type": "object",
      "required": ["score", "reason"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "rubric": {
      "type": "object",
      "required": ["readability", "naming", "idiomaticity", "maintainability", "error_risk", "automation_traces"],
      "additionalProperties": false,
      "properties": {
        "readability": {"$ref": "#/$defs/rating"},
        "naming": {"$ref": "#/$defs/rating"},
        "idiomaticity": {"$ref": "#/$defs/rating"},
        "maintainability": {"$ref": "#/$defs/rating"},
        "error_risk": {"$ref": "#/$defs/rating"},
        "automation_traces": {"$ref": "#/$defs/rating"}
      }
    }
  }
}
