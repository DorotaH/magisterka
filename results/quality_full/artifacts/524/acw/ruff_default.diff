+def max_sum_increasing_subsequence(arr, n):
+    max = 0
+    msis = [0 for _ in range(n)]
+    for i in range(n):
+        msis[i] = arr[i]
+    for i in range(1, n):
+        for j in range(i):
+            if arr[j] < arr[i] and msis[i] < msis[j] + arr[i]:
+                msis[i] = msis[j] + arr[i]
+    for i in range(n):
+        max = max(max, msis[i])
+    return max
