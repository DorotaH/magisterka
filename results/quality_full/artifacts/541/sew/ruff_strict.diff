+import math
+
+
+def get_sum(n):
+    sum = 0
+    i = 1
+    while i <= (math.sqrt(n)):
+        if n % i == 0:
+            if not n / i == i:
+                sum = sum + i
+                sum = sum + (n / i)
+            else:
+                sum = sum + i
+        i = i + 1
+    sum -= n
+    return sum
+
+
+def check_abundant(n):
+    if get_sum(n) > n:
+        return True
+    return False
