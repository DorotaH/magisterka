+def minimum_Length(s):
+    maxOcc, n = 0, len(s)
+    arr = 26 * [0]
+    for i in range(0, n):
+        arr[ord(s[i]) - ord("a")] += 1
+    for i in range(0, 26):
+        if maxOcc < arr[i]:
+            maxOcc = arr[i]
+    return n - maxOcc
