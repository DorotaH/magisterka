+def get_maxgold(gold, m, n):
+    goldTable = [[0 for _ in range(n)] for _ in range(m)]
+    for col in range(n - 1, -1, -1):
+        for row in range(m):
+            right = 0 if (col == n - 1) else goldTable[row][1 + col]
+            right_up = 0 if (row == 0 or col == n - 1) else goldTable[row - 1][1 + col]
+            right_down = (
+                0 if (row == m - 1 or col == n - 1) else goldTable[1 + row][1 + col]
+            )
+            goldTable[row][col] = max(right, right_up, right_down) + gold[row][col]
+    res = goldTable[0][0]
+    for i in range(1, m):
+        res = max(res, goldTable[i][0])
+    return res
