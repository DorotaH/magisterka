+def get_total_number_of_sequences(m, n):
+    T = [[0 for _ in range(1 + n)] for _ in range(1 + m)]
+    for i in range(1 + m):
+        for j in range(1 + n):
+            if i == 0 or j == 0 or i < j:
+                T[i][j] = 0
+            elif j == 1:
+                T[i][j] = i
+            else:
+                T[i][j] = T[i - 1][j] + T[i // 2][j - 1]
+    return T[m][n]
