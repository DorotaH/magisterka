+def ncr_modp(n, r, p):
+    C = [0 for i in range(0, r + 1)]
+    C[0] = 1
+    for i in range(1, 1 + n):
+        for j in range(min(i, r), 0, -1):
+            C[j] = (C[j] + C[j - 1]) % p
+    return C[r]
