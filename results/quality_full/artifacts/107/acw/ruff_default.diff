+def count_Hexadecimal(L, R):
+    count = 0
+    for i in range(L, R + 1):
+        if i >= 10 and 15 >= i:
+            count += 1
+        elif 15 < i:
+            k = i
+            while k != 0:
+                if k % 16 >= 10:
+                    count += 1
+                k = k // 16
+    return count
