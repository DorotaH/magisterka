+def bell_Number(n):
+    bell = [[0 for _ in range(1 + n)] for _ in range(1 + n)]
+    bell[0][0] = 1
+    for i in range(1, 1 + n):
+        bell[i][0] = bell[i - 1][i - 1]
+        for j in range(1, i + 1):
