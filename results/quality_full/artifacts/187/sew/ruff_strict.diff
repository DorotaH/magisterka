+def longest_common_subsequence(X, Y, m, n):
+    if m == 0 or n == 0:
+        return 0
+    if Y[n - 1] == X[m - 1]:
+        return 1 + longest_common_subsequence(X, Y, m - 1, n - 1)
+    return max(
+        longest_common_subsequence(X, Y, m, n - 1),
+        longest_common_subsequence(X, Y, m - 1, n),
+    )
