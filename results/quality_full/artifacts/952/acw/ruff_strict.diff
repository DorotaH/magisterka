+def nCr_mod_p(n, r, p):
+    r = min(r, n - r)
+    C = [0 for _ in range(1 + r)]
+    C[0] = 1
+    for i in range(1, 1 + n):
+        for j in range(min(i, r), 0, -1):
+            C[j] = (C[j] + C[j - 1]) % p
+    return C[r]
